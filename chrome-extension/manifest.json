{
  "manifest_version": 3,
  "name": "Job Search Clipper",
  "version": "1.1.0",
  "description": "Capture job postings from any page and save them to your local job tracker.",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "host_permissions": ["https://jobs.fieldlines.org/*", "http://localhost:3000/*", "https://*/*", "http://*/*"],
  "action": {
    "default_title": "Clip this job posting"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
