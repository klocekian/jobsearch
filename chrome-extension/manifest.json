{
  "manifest_version": 3,
  "name": "Job Search Clipper",
  "version": "1.2.0",
  "description": "Save job postings from any site to your jobs.fieldlines.org tracker, and fill application forms from your profile.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://jobs.fieldlines.org/*",
    "http://localhost:3000/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "Clip this job posting"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
