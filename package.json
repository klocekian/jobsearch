{
  "name": "jobsearch",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:http",
    "test:unit": "tsx --tsconfig tsconfig.json --test 'tests/unit/*.test.mts'",
    "test:http": "node --test --test-concurrency=1 'tests/http/*.test.mjs'",
    "astryx": "node node_modules/@astryxdesign/cli/bin/astryx.mjs",
    "mcp": "tsx --tsconfig tsconfig.json src/mcp/stdio.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@astryxdesign/core": "^0.1.2",
    "@astryxdesign/theme-neutral": "^0.1.2",
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/typography": "^0.5.20",
    "geist": "^1.7.2",
    "jspdf": "^4.2.1",
    "next": "16.2.9",
    "pdfjs-dist": "^6.0.227",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.1.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
